# ==============================================================================
# Dynamic Multi-Line Bash Prompt Configuration
# Structure: Header (Metadata/Timer) -> Conditional Rows (Git/Venv) -> Input Line
# ==============================================================================

# Disable standard Python virtual environment prompt modification so we can
# format and display active virtual environments in our custom prompt structure.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# ------------------------------------------------------------------------------
# Function: parse_git_status
# Purpose:  Inspects current repository state using fast porcelain v2 status output.
# Returns:  Colon-delimited string (branch|action:symbols:sync_counts)
# ------------------------------------------------------------------------------
parse_git_status() {
    # Verify if the current directory is inside a valid Git repository working tree.
    # Redirect standard output and errors to /dev/null; exit function if false.
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

    # Extract current branch name. If in a detached HEAD state, fall back to short commit hash.
    local branch
    branch=$(git branch --show-current 2>/dev/null)
    [ -z "$branch" ] && branch=$(git rev-parse --short HEAD 2>/dev/null)

    # Check for active multi-step Git operations (Rebase, Merge, Cherry-Pick)
    local git_dir
    git_dir=$(git rev-parse --git-dir 2>/dev/null)
    local state=""
    if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
        state="|REBASE"
    elif [ -f "$git_dir/MERGE_HEAD" ]; then
        state="|MERGE"
    elif [ -f "$git_dir/CHERRY_PICK_HEAD" ]; then
        state="|CHERRY-PICK"
    fi

    # Retrieve porcelain v2 status output (provides structured data for changes and tracking)
    local status_out
    status_out=$(git status --porcelain=v2 --branch 2>/dev/null)

    # Initialize tracking variables for file states and remote branch commit offset
    local staged=0 modified=0 untracked=0 ahead=0 behind=0

    # Temporarily disable pathname expansion (globbing) to safely parse lines containing '*' or '?'
    set -f

    # Fast line-by-line parsing using pure Bash builtin pattern matching and array splitting
    local line
    while IFS= read -r line; do
        case "$line" in
            "# branch.ab "*)
                # Parse ahead (+) and behind (-) commit counts relative to upstream
                # tokens array: [0]="#", [1]="branch.ab", [2]="+ahead", [3]="-behind"
                local tokens=($line)
                ahead="${tokens[2]#+}"
                behind="${tokens[3]#-}"
                ;;
            "1 "*|"2 "*)
                # Parse tracked files (ordinary or renamed): tokens[1] contains XY status flags
                # X represents index/staged status; Y represents working tree/modified status
                local tokens=($line)
                local xy="${tokens[1]}"
                [ "${xy:0:1}" != "." ] && staged=1
                [ "${xy:1:1}" != "." ] && modified=1
                ;;
            "? "*)
                # Flag presence of untracked files
                untracked=1
                ;;
        esac
    done <<< "$status_out"

    # Re-enable pathname expansion (globbing)
    set +f

    # Assemble uncommitted status flags (+ = staged, * = modified, ? = untracked)
    local symbols=""
    [ $staged -eq 1 ] && symbols+="+"
    [ $modified -eq 1 ] && symbols+="*"
    [ $untracked -eq 1 ] && symbols+="?"

    # Set checkmark symbol (✔) when working tree has no uncommitted modifications
    [ -z "$symbols" ] && symbols="✔"

    # Assemble upstream sync tracking indicators (⇡ = ahead, ⇣ = behind)
    local sync=""
    [ "$ahead" -gt 0 ] 2>/dev/null && sync+="⇡${ahead}"
    [ "$behind" -gt 0 ] 2>/dev/null && sync+="⇣${behind}"

    # Output formatted raw component values delimited by colons
    echo "${branch}${state}:${symbols}:${sync}"
}

# ------------------------------------------------------------------------------
# Functions: Command Duration Timer (DEBUG Trap)
# Purpose:  Measures command execution duration and constructs formatted string.
# ------------------------------------------------------------------------------

# Global variable declarations for execution timer
declare -g timer=""
declare -g TIMEDELTA=""

# Record starting timestamp in seconds when a user executes a command
timer_start() {
    [ -z "$timer" ] && timer=$SECONDS
}

# Calculate total execution duration upon command completion
timer_stop() {
    if [ -n "$timer" ]; then
        local delta=$((SECONDS - timer))
        # Render the timer string only if command duration is 1 second or longer
        if [ $delta -ge 1 ]; then
            local hours=$((delta / 3600))
            local minutes=$(((delta % 3600) / 60))
            local seconds=$((delta % 60))
            
            # Format timer string using ANSI-C quoting with vibrant orange color (\e[38;5;208m)
            TIMEDELTA=$'(\e[38;5;208m⏱ '
            [ $hours -gt 0 ] && TIMEDELTA+="${hours}h "
            [ $minutes -gt 0 ] && TIMEDELTA+="${minutes}m "
            TIMEDELTA+="${seconds}s"$'\e[38;5;35m)'
        else
            TIMEDELTA=""
        fi
        timer=""
    else
        TIMEDELTA=""
    fi
}

# Set DEBUG trap to execute timer_start prior to running any command
trap 'timer_start' DEBUG

# ------------------------------------------------------------------------------
# Function: update_prompt
# Purpose:  Main PROMPT_COMMAND function invoked prior to rendering each prompt.
# ------------------------------------------------------------------------------
update_prompt() {
    # Capture exit status of the previously executed command ($?)
    local exit_code=$?
    
    # Process execution timer state
    timer_stop

    # Declare prompt component variables globally so PS1 can read them directly
    declare -g GIT_BRANCH="" VENV_PROMPT="" EXIT_SEQ=""

    # Construct FTCS terminal shell integration sequence for command exit status
    EXIT_SEQ=$'\e]133;D;'${exit_code}$'\a'

    # Build dynamic Git status prompt line
    local git_info
    git_info=$(parse_git_status)

    if [ -n "$git_info" ]; then
        local branch_str="" symbols_str="" sync_str=""
        
        # Extract components safely using parameter expansion
        branch_str="${git_info%%:*}"
        local rest="${git_info#*:}"
        symbols_str="${rest%%:*}"
        sync_str="${rest#*:}"

        # Format base Git branch string in darker blue color (\e[38;5;32m)
        GIT_BRANCH=$'\e[38;5;35m├─(\e[38;5;32mgit:'"$branch_str"
        
        # Apply green color (\e[38;5;35m) for clean checkmark or orange (\e[38;5;208m) for active changes
        if [ "$symbols_str" = "✔" ]; then
            GIT_BRANCH+=$' \e[38;5;35m✔'
        elif [ -n "$symbols_str" ]; then
            GIT_BRANCH+=$' \e[38;5;208m'"$symbols_str"
        fi
        
        # Format upstream ahead/behind sync counters in warm yellow (\e[38;5;220m)
        if [ -n "$sync_str" ]; then
            GIT_BRANCH+=$' \e[38;5;220m'"$sync_str"
        fi

        GIT_BRANCH+=$'\e[38;5;35m)\n'
    fi

    # Build dynamic Python Virtual Environment prompt line in vibrant orange (\e[38;5;208m)
    if [ -n "$VIRTUAL_ENV" ]; then
        local venv_name
        venv_name=$(basename "$VIRTUAL_ENV")
        VENV_PROMPT=$'\e[38;5;35m├─(\e[38;5;208mvenv:'"$venv_name"$'\e[38;5;35m)\n'
    fi
}

# Attach update_prompt to PROMPT_COMMAND hook to refresh variables before prompt rendering
PROMPT_COMMAND=update_prompt

# ------------------------------------------------------------------------------
# Main PS1 Structure Definition
# Non-printing sequence brackets \[\...\] wrap ANSI escape codes to prevent cursor offset & line-wrapping bugs.
# Breakdown of ANSI codes and bash escape sequences used below:
#   \[$EXIT_SEQ\]             - Final Term command exit status OSC sequence (\e]133;D;<code>\a)
#   \[\e]133;A\a\]            - Final Term prompt start OSC sequence (marks beginning of prompt)
#   \[\e[0m\]                 - Reset all text attributes, colors, and formatting
#   \[\e[38;5;35m\]           - Set foreground color to 256-color green (Code 35) for prompt borders
#   ╭─(...)                   - Structural multi-line box characters
#   \[\e[38;5;38m\]           - Set foreground color to 256-color cyan (Code 38) for metadata
#   \t                        - Current time in 24-hour HH:MM:SS format
#   \j                        - Number of active background job instances
#   \H                        - Full hostname of the operating system
#   \w                        - Current working directory path (~ for home)
#   ${TIMEDELTA}              - Evaluated command duration block (orange: \e[38;5;208m)
#   \n                        - Line break to push Git/Venv/Input rows down
#   ${GIT_BRANCH}${VENV_PROMPT} - Dynamic secondary status lines built in update_prompt
#   ╰─                        - Terminal prompt bottom connector string
#   ❯_                        - Terminal prompt symbol
#   \[\e]133;B\a\]            - Final Term command start OSC sequence (marks beginning of user input)
# ------------------------------------------------------------------------------
export PS1='\[$EXIT_SEQ\]\[\e]133;A\a\]\[\e[0m\]\[\e[38;5;35m\]╭─(\[\e[38;5;38m\]\t\[\e[38;5;35m\])-(\[\e[38;5;38m\]\j\[\e[38;5;35m\])-(\[\e[38;5;38m\]\H\[\e[38;5;35m\])-(\[\e[38;5;38m\]\w\[\e[38;5;35m\])${TIMEDELTA}\n${GIT_BRANCH}${VENV_PROMPT}\[\e[38;5;35m\]╰─\[\e[38;5;38m\]❯_\[\e[0m\]\[\e]133;B\a\] '
